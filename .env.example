# ==============================================================================
# ALMA ENVIRONMENT CONFIGURATION (TEMPLATE)
# Copy this file to .env or .env.local and replace with your actual values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & DATABASE
# ------------------------------------------------------------------------------
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=your_long_random_secret_here_min_32_characters
MONGODB_URI=mongodb://127.0.0.1:27017/alumni_network
MONGODB_DB=alumni_network
AUTH_TRUSTED_ORIGINS=http://localhost:3000
DEFAULT_USER_ROLE=student

# ------------------------------------------------------------------------------
# 2. SYSTEM CAPACITY & THROTTLING THRESHOLDS (FATAL IF MISSING)
# ------------------------------------------------------------------------------
MAX_MENTEES_PER_MENTOR=5
MAX_MENTORS_PER_STUDENT=5
MAX_PENDING_REQUESTS_PER_STUDENT=5

# ------------------------------------------------------------------------------
# 3. TRANSACTIONAL EMAIL (RESEND)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# ------------------------------------------------------------------------------
# 4. MEDIA & FILE UPLOADS (CLOUDINARY)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_PRESET=alma_avatars
NEXT_PUBLIC_CLOUDINARY_BANNER_PRESET=alma_banners
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# ------------------------------------------------------------------------------
# 5. REAL-TIME WEBSOCKET MESSAGING (PUSHER)
# ------------------------------------------------------------------------------
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_app_key
PUSHER_SECRET=your_pusher_app_secret
PUSHER_CLUSTER=mt1
NEXT_PUBLIC_PUSHER_KEY=your_pusher_app_key
NEXT_PUBLIC_PUSHER_CLUSTER=mt1

# ------------------------------------------------------------------------------
# 6. UPSTASH REDIS (CACHE, RATE LIMITS & DISTRIBUTED LOCK)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Cache TTLs & Time Intervals (in seconds)
REDIS_OTP_TTL_SECONDS=600
AUTH_RATE_LIMIT_WINDOW_SECONDS=120
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
REDIS_MENTORS_CACHE_TTL_SECONDS=600
REDIS_OFFICER_DASHBOARD_CACHE_TTL_SECONDS=180
REDIS_STUDENT_ANALYTICS_CACHE_TTL_SECONDS=900

# Mentor Request Distributed Lock (Redis Concurrency Guard)
REDIS_MENTOR_LOCK_TTL_SECONDS=2
REDIS_MENTOR_LOCK_RETRY_COUNT=3
REDIS_MENTOR_LOCK_RETRY_DELAY_MS=150
