BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=your_long_random_secret_here
MONGODB_URI=mongodb://127.0.0.1:27017/alumni_network
MONGODB_DB=alumni_network
AUTH_TRUSTED_ORIGINS=http://localhost:3000
DEFAULT_USER_ROLE=student
RESEND_API_KEY=re_your_test_key
RESEND_FROM_EMAIL=onboarding@resend.dev
MAX_MENTEES_PER_MENTOR=5
MAX_MENTORS_PER_STUDENT=5
MAX_PENDING_REQUESTS_PER_STUDENT=5

# Cloudinary (Image & Banner uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_PRESET=alma_avatars
NEXT_PUBLIC_CLOUDINARY_BANNER_PRESET=alma_banners
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://your_cloudinary_url

# Upstash Redis (Serverless In-Memory Caching, Rate Limiting & Ephemeral OTPs)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Cache TTLs & Time Intervals (in seconds)
REDIS_OTP_TTL_SECONDS=600
AUTH_RATE_LIMIT_WINDOW_SECONDS=120
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
REDIS_MENTORS_CACHE_TTL_SECONDS=600
REDIS_OFFICER_DASHBOARD_CACHE_TTL_SECONDS=180
REDIS_STUDENT_ANALYTICS_CACHE_TTL_SECONDS=900
